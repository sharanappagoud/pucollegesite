# ===================================================================
# MPUC Pre-University College - Backend Environment Variables
# ===================================================================

# Application Server Port (Defaults to 8085 to avoid conflicts with other local services)
PORT=8085
SERVER_PORT=8085

# MySQL 8 Database Credentials & Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mpuc_college
DB_USERNAME=mpuc_app
DB_PASSWORD=Mpuc@Secure2026!
DB_URL=jdbc:mysql://localhost:3306/mpuc_college?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Spring Data JPA / Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_OPEN_IN_VIEW=false

# JWT Authentication Secret (Must be 256-bit Base64 encoded key)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173

# File Upload Directory
APP_UPLOAD_DIR=./uploads

# Spring Mail (Optional - disabled by default)
SPRING_MAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=admissions@svcpuc.edu.in
SPRING_MAIL_PASSWORD=your_app_password
